{
  "files.autoSave": "off",
  "workbench.editor.enablePreview": true,
  "workbench.editor.closeEmptyEditorOnBlur": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/data/cache/**": true
  }
}
